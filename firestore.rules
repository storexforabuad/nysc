rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── Users Collection & Subcollections ──
    match /users/{userId} {
      // User can read their own profile, admin can read/list all
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false; // Writes strictly handled server-side (Admin SDK)

      // Partner Contacts Subcollection
      match /contacts/{contactId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Partner Promos Subcollection (Campaigns & Claims)
      match /promos/{promoId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Partner Manual Orders Subcollection
      match /manualOrders/{orderId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ── Global Promos Collection (Aggregated reporting for Admin/Partner) ──
    match /promos/{promoId} {
      allow read: if isSignedIn() && (resource.data.storeId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── CDS Micro-Grant Proposals Collection ──
    match /cds_proposals/{proposalId} {
      // Corps members can view/list their own proposals; Admin can view all
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Plans Cache ──
    match /plans_cache/{planId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Status Captions ──
    match /status_captions/{captionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Ledger & Transactions ──
    match /ledger/{entryId} {
      // Allows partners to read/query their own ledger history (sales, withdrawals, broadcasts)
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Opt-outs Collection ──
    match /optouts/{optoutId} {
      allow read: if isSignedIn() && (resource.data.storeId == request.auth.uid || isAdmin());
      allow write: if false;
    }
  }
}
